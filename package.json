{
  "name": "epub-reader",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web npm:dev:server npm:dev:web",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "^9.2.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.11"
  }
}
